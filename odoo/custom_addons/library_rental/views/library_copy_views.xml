<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_library_copy_list" model="ir.ui.view">
        <field name="name">library.copy.list</field>
        <field name="model">library.copy</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'available'" decoration-danger="state in ('lost', 'damaged')">
                <field name="name"/>
                <field name="book_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_library_copy_form" model="ir.ui.view">
        <field name="name">library.copy.form</field>
        <field name="model">library.copy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="book_id"/>
                        <field name="state"/>
                    </group>
                    <notebook>
                        <page string="Історія видач">
                            <field name="loan_ids">
                                <list>
                                    <field name="member_id"/>
                                    <field name="loan_date"/>
                                    <field name="due_date"/>
                                    <field name="return_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_library_copy_search" model="ir.ui.view">
        <field name="name">library.copy.search</field>
        <field name="model">library.copy</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="book_id"/>
                <filter name="available" string="Доступні" domain="[('state', '=', 'available')]"/>
                <filter name="loaned" string="Видані" domain="[('state', '=', 'loaned')]"/>
                <filter name="lost" string="Втрачені" domain="[('state', '=', 'lost')]"/>
                <filter name="damaged" string="Пошкоджені" domain="[('state', '=', 'damaged')]"/>
                <group name="group_by">
                    <filter name="group_book" string="Книгою" domain="[]" context="{'group_by': 'book_id'}"/>
                    <filter name="group_state" string="Станом" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_library_copy" model="ir.actions.act_window">
        <field name="name">Примірники</field>
        <field name="res_model">library.copy</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_library_copy_search"/>
    </record>
</odoo>
