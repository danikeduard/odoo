<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_library_member_list" model="ir.ui.view">
        <field name="name">library.member.list</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="card_number"/>
                <field name="email"/>
                <field name="phone"/>
            </list>
        </field>
    </record>
    <record id="view_library_member_form" model="ir.ui.view">
        <field name="name">library.member.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="card_number"/>
                        <field name="email"/>
                        <field name="phone"/>
                    </group>
                    <notebook>
                        <page string="Видачі">
                            <field name="loan_ids">
                                <list>
                                    <field name="copy_id"/>
                                    <field name="loan_date"/>
                                    <field name="due_date"/>
                                    <field name="return_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_library_member_search" model="ir.ui.view">
        <field name="name">library.member.search</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="card_number"/>
                <field name="email"/>
                <filter name="has_loans" string="Мають видачі" domain="[('loan_ids', '!=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_library_member" model="ir.actions.act_window">
        <field name="name">Читачі</field>
        <field name="res_model">library.member</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_library_member_search"/>
    </record>
</odoo>
